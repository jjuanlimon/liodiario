---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NoticiaCard from '../../components/NoticiaCard.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import AdSlot from '../../components/AdSlot.astro';
import TipoBadge from '../../components/TipoBadge.astro';
import { SITE, slugify } from '../../config';
import { getNoticias, fechaLarga, youtubeId, type Noticia } from '../../lib/noticias';

export async function getStaticPaths() {
  const all = await getNoticias();
  return all.map((noticia) => ({ params: { id: noticia.id }, props: { noticia, all } }));
}

interface Props { noticia: Noticia; all: Noticia[] }
const { noticia, all } = Astro.props;
const { title, description, date, category, image, imageAlt, video, real, source, sourceUrl } = noticia.data;
const { Content } = await render(noticia);
const yt = youtubeId(video);
const url = new URL(`/noticias/${noticia.id}/`, SITE.url).href;
const shareImage = image || (yt ? `https://i.ytimg.com/vi/${yt}/hqdefault.jpg` : null);
const related = [
  ...all.filter((n) => n.id !== noticia.id && n.data.category === category),
  ...all.filter((n) => n.id !== noticia.id && n.data.category !== category),
].slice(0, 3);
---
<Base title={title} description={description || title} image={shareImage} type="article" publishedTime={date} real={real}>
  <article class="article">
    <header class="article-head">
      <div class="chips">
        <a class="chip" href={`/categoria/${slugify(category)}/`}>{category}</a>
        <TipoBadge real={real} />
      </div>
      <h1 class="article-title">{title}</h1>
      {description && <p class="article-lead">{description}</p>}
      <time class="card-date" datetime={date.toISOString()}>{fechaLarga(date)}</time>
    </header>

    <figure class="article-media">
      {yt ? (
        <div class="video">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${yt}`}
            title={title}
            loading="lazy"
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      ) : image ? (
        <img src={image} alt={imageAlt || title} width="1200" height="675" />
      ) : null}
      {imageAlt && !yt && <figcaption>{imageAlt}</figcaption>}
    </figure>

    <ShareButtons url={url} title={title} real={real} />

    <div class="prose">
      <Content />
    </div>

    <AdSlot />

    {real ? (
      <p class="article-disclaimer article-disclaimer--real">
        ✅ <strong>Esta es una noticia real.</strong>
        {source && (
          <> Fuente: {sourceUrl ? <a href={sourceUrl} target="_blank" rel="noopener nofollow">{source}</a> : source}.</>
        )}
      </p>
    ) : (
      <p class="article-disclaimer">😂 <strong>Esta noticia es SÁTIRA:</strong> es inventada y fue escrita para hacer reír.</p>
    )}

    <ShareButtons url={url} title={title} real={real} />
  </article>

  {related.length > 0 && (
    <section aria-labelledby="mas">
      <h2 id="mas" class="section-title">Más líos</h2>
      <div class="grid">
        {related.map((n) => <NoticiaCard noticia={n} />)}
      </div>
    </section>
  )}
</Base>
