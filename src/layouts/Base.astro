---
import '../styles/global.css';
import { SITE, CATEGORIES, ADSENSE, slugify } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishedTime,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} · Noticias de humor y sátira`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image || SITE.defaultImage, SITE.url).href;
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="es-DO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FFD200" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Vista previa al compartir (WhatsApp, Facebook, X) -->
    <meta property="og:site_name" content="Lío Diario · Sátira" />
    <meta property="og:locale" content="es_DO" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={`😂 SÁTIRA · ${description}`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? SITE.name} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={`😂 SÁTIRA · ${description}`} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Letra Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,600;0,800;0,900;1,400&display=swap"
      rel="stylesheet"
    />

    {ADSENSE.enabled && ADSENSE.client && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label="Lío Diario, ir a la portada">
          <img src="/logo-192.png" width="56" height="56" alt="" class="brand-logo" />
          <span class="brand-text">
            <span class="brand-name">LÍO DIARIO</span>
            <span class="brand-tag">Noticias que nunca pasaron</span>
          </span>
        </a>
      </div>
      <nav class="site-nav" aria-label="Categorías">
        <ul class="wrap nav-list">
          <li><a href="/" aria-current={current === '/' ? 'page' : undefined}>Portada</a></li>
          {CATEGORIES.map((c) => {
            const href = `/categoria/${slugify(c)}/`;
            return (
              <li>
                <a href={href} aria-current={current.startsWith(href.slice(0, -1)) ? 'page' : undefined}>{c}</a>
              </li>
            );
          })}
        </ul>
      </nav>
    </header>

    <div class="satire-bar" role="note">
      <div class="wrap">
        <span class="satire-chip">SÁTIRA</span>
        <span>{SITE.disclaimer}</span>
      </div>
    </div>

    <main class="wrap main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <img src="/logo-192.png" width="44" height="44" alt="" class="brand-logo" />
          <strong>LÍO DIARIO</strong>
        </div>
        <p class="footer-disclaimer">{SITE.disclaimer} Cualquier parecido con la realidad es pura coincidencia (o culpa del país).</p>
        <ul class="footer-links">
          <li><a href="/quienes-somos/">Quiénes somos</a></li>
          <li><a href="/privacidad/">Política de privacidad</a></li>
          <li><a href={`mailto:${SITE.email}`}>Contacto</a></li>
        </ul>
        <p class="footer-copy">© {new Date().getFullYear()} Lío Diario · liodiario.com</p>
      </div>
    </footer>
  </body>
</html>
