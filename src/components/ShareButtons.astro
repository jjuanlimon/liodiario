---
interface Props { url: string; title: string; real?: boolean }
const { url, title, real = false } = Astro.props;
const u = encodeURIComponent(url);
const text = encodeURIComponent(real ? `✅ ${title} (vía Lío Diario)` : `${title} 😂 (sátira de Lío Diario)`);
const links = {
  whatsapp: `https://wa.me/?text=${text}%20${u}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
  x: `https://x.com/intent/post?text=${text}&url=${u}`,
};
---
<div class="share">
  <span class="share-label">Compartir:</span>
  <a class="share-btn share-btn--wa" href={links.whatsapp} target="_blank" rel="noopener" aria-label="Compartir en WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
    <span>WhatsApp</span>
  </a>
  <a class="share-btn share-btn--fb" href={links.facebook} target="_blank" rel="noopener" aria-label="Compartir en Facebook">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.4H7.6V14h2.7v8h3.2Z"/></svg>
    <span>Facebook</span>
  </a>
  <a class="share-btn share-btn--x" href={links.x} target="_blank" rel="noopener" aria-label="Compartir en X">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.8 3h3.1l-6.8 7.7 8 10.3h-6.3l-4.9-6.4L5.3 21H2.2l7.3-8.3L1.9 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z"/></svg>
    <span>X</span>
  </a>
</div>
